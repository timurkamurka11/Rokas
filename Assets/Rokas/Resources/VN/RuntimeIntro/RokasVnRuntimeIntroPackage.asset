      dialogueBeats:
      - beatId: 80649fbfd60c4802b0f15780ab800701
        speaker: Mina
        text: "\u041D\u0443-\u043D\u0443! \u0427\u0442\u043E \u044D\u0442\u043E \u0442\u044B
          \u0434\u0435\u043B\u0430\u0435\u0448\u044C? \u041C\u044B \u0443\u0436\u0435
          \u043D\u0435 \u0432 \u0442\u043E\u043C \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435,
          \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0442 \u0442\u0430\u043A \u0433\u043B\u0430\u0434\u0438\u0442\u044C
          \u043C\u0435\u043D\u044F \u043F\u043E \u0433\u043E\u043B\u043E\u0432\u0435\u2026
          \u0425\u043E\u0442\u044F, \u0435\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E,
          \u044F \u0431\u044B \u0441\u043E\u0432\u0440\u0430\u043B\u0430, \u0435\u0441\u043B\u0438
          \u0431\u044B \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E
          \u043C\u043D\u0435 \u044D\u0442\u043E \u0441\u043E\u0432\u0441\u0435\u043C
          \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F."
        narration: 0
        targetCharacterId: 
        hasStateOverride: 0
        stateId: 
        effect: 0
