    \"Mina\",\n                    \"text\": \"\u0412 \u0440\u0430\u0439\u043E\u043D\u0435
    \u041A\u0430\u0431\u0443\u043A\u043E \u043E\u0447\u0435\u0432\u0438\u0434\u0446\u044B
