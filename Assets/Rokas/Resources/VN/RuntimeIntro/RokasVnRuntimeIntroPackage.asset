      - beatId: e16b384fa065424d8bd4a4de1a7aa4bf
        speaker: Keiko
        text: "\u0427\u0442\u043E \u0436, \u0442\u043E\u0433\u0434\u0430 \u043F\u0435\u0440\u0432\u044B\u043C
          \u0434\u0435\u043B\u043E\u043C \u0432\u0435\u0440\u043D\u0451\u043C\u0441\u044F
          \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u044E. \u0417\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u043C\u0441\u044F,
          \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435
          \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0430 \u043F\u043E\u0442\u043E\u043C
          \u0440\u0435\u0448\u0438\u043C, \u043A\u0443\u0434\u0430 \u0432\u044B\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F.
          \u0425\u043E\u0440\u043E\u0448\u043E \u0445\u043E\u0442\u044C \u0432\u0441\u0451
          \u043C\u043E\u0436\u043D\u043E \u043E\u0444\u043E\u0440\u043C\u0438\u0442\u044C
          \u043F\u0440\u044F\u043C\u043E \u043E\u0442\u0441\u044E\u0434\u0430 \u0432
          \u043D\u043E\u0443\u0442\u0431\u0443\u043A\u0435."
