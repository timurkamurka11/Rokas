        text: "\u041B\u0430\u0434\u043D\u043E, \u044F \u043F\u043E\u0448\u043B\u0430.
          \u041D\u0435 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0439, \u043A\u043B\u044E\u0447
          \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C. \u0421\u043A\u043E\u0440\u043E
          \u0435\u0449\u0451 \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F. \u0418
          \u0434\u0430 \u2014 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0445\u043E\u0442\u044F
          \u0431\u044B \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
          \u043B\u0435\u0447\u044C \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435."
