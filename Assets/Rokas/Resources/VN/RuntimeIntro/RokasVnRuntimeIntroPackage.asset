    \"dialogueBeats\": [\n                {\n                    \"beatId\": \"8e7281f602a34f0d8eba3d8f4f8f4717\",\n                   
    \"speaker\": \"Mina\",\n                    \"text\": \"\u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438
    \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u0443 \u043C\u0435\u043D\u044F
    \u0435\u0441\u0442\u044C \u0432\u044B\u0431\u043E\u0440. \u0422\u044B \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E
    \u0437\u043D\u0430\u0435\u0448\u044C: \u044F \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C
    \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u041F\u043E\u0440\u0442\u0430\u043B\u044B
    \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043B\u0438 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0442\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C, \u043D\u043E \u0438
    \u043C\u043E\u044E. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0442\u043E\u0436\u0435
    \u0431\u0443\u0434\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u2014 \u0438 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430 \u044D\u0442\u043E \u0431\u0435\u0440\u0443 \u043D\u0430 \u0441\u0435\u0431\u044F
    \u0441\u0430\u043C\u0430.\",\n                    \"narration\": false,\n                   
    \"targetCharacterId\": \"\",\n                    \"hasStateOverride\": false,\n                   
    \"stateId\": \"\",\n                    \"effect\": 0,\n                    \"effectStrength\":
