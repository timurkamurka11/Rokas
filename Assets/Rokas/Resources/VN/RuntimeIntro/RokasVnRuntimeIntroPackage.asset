        speaker: Mina
        text: "\u0414\u0430\u2026 \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E.
          \u0418 \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
          \u0442\u0435\u0431\u044F \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C,
